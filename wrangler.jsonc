{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "standby-flight-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "standby-flight-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
